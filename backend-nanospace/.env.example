NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/nanospace
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Simulated Razorpay checkout for development only; never used when NODE_ENV=production.
RAZORPAY_DEMO_MODE=true
# Generate a random 32-byte key (64 hex characters) to encrypt branch Razorpay secrets:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RAZORPAY_CREDENTIALS_ENCRYPTION_KEY=
# Configure SMTP to send password reset and sign-in emails to users.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
ADMIN_NAME=NanoSpace Super Admin
ADMIN_EMAIL=admin@nanospace.local
ADMIN_PASSWORD=replace_with_a_strong_unique_password
